# Solstein v2 — environment variables
#
# Copy to .env and fill in. .env is gitignored.

# GitHub adapter: personal access token with public_repo scope
# Without a token: 60 req/hour (fine for dev). With: 5000 req/hour.
GITHUB_TOKEN=

# Companies House (UK) — free API key, register at:
# https://developer.company-information.service.gov.uk/
# Without a key, the adapter logs a warning and skips cleanly. No fake data.
COMPANIES_HOUSE_API_KEY=

# Loguru log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
